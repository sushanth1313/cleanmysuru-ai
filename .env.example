# =====================================================================
# CleanMysuru AI — Environment Variables Reference
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (Vercel Project Settings)
# ---------------------------------------------------------------------
# Set this to your live Render backend URL with /api suffix.
NEXT_PUBLIC_API_URL="https://cleanmysuru-ai.onrender.com/api"

# ---------------------------------------------------------------------
# BACKEND (Render Web Service Settings)
# ---------------------------------------------------------------------
NODE_ENV="production"
PORT=5000
FRONTEND_URL="https://cleanmysuru-ai-ajeg.vercel.app"
JWT_SECRET="cleanmysuru_jwt_secret_dev_key_2025"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.jqcom5s.mongodb.net/cleanmysuru_ai?retryWrites=true&w=majority"

# AI Provider Configuration (Google Gemini)
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_API_KEY="your_gemini_api_key_here"

UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------
# LOCAL DEVELOPMENT DEFAULTS
# ---------------------------------------------------------------------
# Frontend local: NEXT_PUBLIC_API_URL="http://localhost:5000/api"
# Backend local: PORT=5000, FRONTEND_URL="http://localhost:3000", MONGODB_URI="mongodb://127.0.0.1:27017/cleanmysuru_ai"
